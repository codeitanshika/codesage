# Copy to .env and fill in your own values. Never commit .env itself.

# Required — free key, no credit card: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional — raises GitHub's API rate limit for /contribute's issue
# lookup from 60/hr to 5,000/hr. /contribute works fine without it.
GITHUB_TOKEN=your_github_token_here

# Optional — comma-separated list of allowed frontend origins for CORS.
# Defaults to "*" (any origin) if unset, which is fine for local dev.
# Set this to your deployed frontend's URL once it's live, e.g.:
# ALLOWED_ORIGINS=https://codesage.vercel.app
ALLOWED_ORIGINS=*
